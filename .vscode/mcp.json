{
  "servers": {
    "state-memory-mcp": {
      "command": "state-memory-mcp",
      "args": [
        "run"
      ],
      "env": {
        "STATE_MEMORY_MCP_PROJECT": "spc",
        "STATE_MEMORY_COMPAT": "true"
      }
    },
    "vision-memory-mcp": {
      "type": "stdio",
      "command": "vision-memory-mcp",
      "args": [
        "run"
      ],
      "env": {
        "LANCEDB_PATH": "./.vision-memory-mcp"
      }
    }
  }
}
