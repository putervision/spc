    "cpp",
    "csharp",
    "elixir",
    "fortran",
    "golang",
    "haskell",
    "java",
    "javascript",
    "julia",
    "kotlin",
    "linter",
    "lua",
    "nasa-rules",
    "php",
    "power-of-ten",
    "putervision",
    "python",
    "ruby",
    "rust",
    "scala",
    "secure-coding",
    "security-analysis",
    "space-proof-code",
    "spaceproof",
    "spc",
    "static-analysis",
    "swift",
    "typescript",
    "vulnerability-scanner",
    "zig"
  ],
  "homepage": "https://github.com/putervision/spc#readme",
  "bugs": {
    "url": "https://github.com/putervision/spc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/putervision/spc.git"
  },
  "license": "MIT",
  "author": "PuterVision <code@putervision.com>",
  "main": "lib/scanner.js",
  "bin": {
    "space-proof-code": "./bin/cli.js",
    "spc": "./bin/cli.js"
  },
  "scripts": {
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "prepublishOnly": "npm run test",
    "release": "npm publish --access public",
    "scan": "node bin/cli.js",
    "scan:test": "node bin/cli.js ./test/examples/",
    "self-check": "node bin/cli.js ./lib ./bin",
    "start": "node bin/cli.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "volta": {
    "node": "18.20.4"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}