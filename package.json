{
  "name": "@putervision/spc",
  "version": "1.2.0",
  "description": "High-performance zero-dependency static analysis tool enforcing NASA Power of Ten reliability and security rules across 20 programming languages (JS/TS, Python, C/C++, Go, Rust, Java, Ada, C#, Fortran, Haskell, Kotlin, Lua, PHP, Ruby, Scala, Swift, Zig, Julia, Elixir, Shell/Bash).",
  "keywords": [
