  "homepage": "https://github.com/putervision/spc#readme",
  "bugs": {
    "url": "https://github.com/putervision/spc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/putervision/spc.git"
  },
  "license": "MIT",
  "author": "PuterVision <code@putervision.com>",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./scanner": "./lib/scanner.js",
    "./formatter": "./lib/formatter.js",
    "./info": "./lib/info.js",
    "./config": "./lib/config.js",
    "./plugin": "./lib/plugin.js",
    "./checksum": "./lib/checksum.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "space-proof-code": "./bin/cli.js",
    "spc": "./bin/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "lint": "eslint \"**/*.js\"",
    "lint:fix": "eslint \"**/*.js\" --fix",
    "prepublishOnly": "npm run build && npm run test",
    "release": "npm publish --access public",
    "scan": "node bin/cli.js",
    "scan:test": "node bin/cli.js ./test/examples/",
    "self-check": "node bin/cli.js ./lib",
    "start": "node bin/cli.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:matrix": "bash scripts/test-matrix.sh",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "volta": {
    "node": "18.20.4"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}