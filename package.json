{
  "name": "@putervision/spc",
  "version": "1.4.0",
  "description": "High-performance zero-dependency static analysis tool enforcing NASA Power of Ten reliability and security rules across 20 programming languages, plus AI agent, MCP server config, skill, and LLM model configuration security auditing.",
  "files": [
    "bin/",
    "lib/",
    "docs/",
    "dist/",
    "LICENSE",
    "README.md",
    "index.js"
  ],
  "keywords": [
    "ada",
    "agent-audit",
    "agent-guardrails",
    "agent-security",
    "ai-agent-scanner",
    "ai-safety",
    "ai-security",
    "bash",
    "ci-cd",
    "code-quality",
    "config-scanner",
    "cpp",
    "csharp",
    "elixir",
    "fortran",
    "golang",
    "haskell",
    "java",
    "javascript",
    "julia",
    "kotlin",
    "linter",
    "llm-config",
    "llm-security",
    "lua",
    "mcp-config-audit",
    "mcp-security",
    "mcp-server",
    "model-config",
    "model-context-protocol",
    "nasa-rules",
    "php",
    "power-of-ten",
    "prompt-injection",
    "putervision",
    "python",
    "ruby",
    "rust",
    "scala",
    "secure-coding",
    "security-analysis",
    "skill-audit",
    "space-proof-code",
    "spaceproof",
    "spc",
    "static-analysis",
    "swift",
    "typescript",
    "vulnerability-scanner",
    "zig"
  ],
  "homepage": "https://github.com/putervision/spc#readme",
  "bugs": {
    "url": "https://github.com/putervision/spc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/putervision/spc.git"
  },
  "license": "MIT",
  "author": "PuterVision <code@putervision.com>",
  "main": "lib/scanner.js",
  "bin": {
    "space-proof-code": "./bin/cli.js",
    "spc": "./bin/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "lint": "eslint \"**/*.js\"",
    "lint:fix": "eslint \"**/*.js\" --fix",
    "prepublishOnly": "npm run build && npm run test",
    "release": "npm publish --access public",
    "scan": "node bin/cli.js",
    "scan:test": "node bin/cli.js ./test/examples/",
    "self-check": "node bin/cli.js ./lib ./bin",
    "start": "node bin/cli.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:matrix": "bash scripts/test-matrix.sh",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "volta": {
    "node": "18.20.4"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}